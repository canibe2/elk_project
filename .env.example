# 이 파일을 복사해서 .env 로 만들고 실제 값을 채운 뒤 사용하세요.
# .env 는 절대 git에 커밋하지 마세요.

ES_HOST=http://localhost:9200
ES_INDEX=ai-security-logs

OLLAMA_URL=http://localhost:11434
# 아래 모델명은 `ollama list` 실행 결과에 실제로 뜨는 이름과 정확히 일치해야 함
# (태그가 다르면 Ollama가 404를 반환함. 예: gemma2 != gemma2:2b)
OLLAMA_MODEL=gemma2:2b
LLM_TIMEOUT_SEC=30

REMOTE_HOST=192.168.111.128
REMOTE_PORT=22
REMOTE_USER=ubuntu
# 가능하면 비밀번호 대신 아래 키 경로 사용을 권장
REMOTE_KEY_PATH=
REMOTE_PASS=

AUTH_LOG_PATH=/var/log/auth.log
WEB_LOG_PATH=/var/log/nginx/access.log

BRUTEFORCE_THRESHOLD=5
BRUTEFORCE_WINDOW_SEC=60
